# Dependencias
FROM node:22-alpine as deps

WORKDIR /usr/src/app

COPY package*.json ./

RUN npm install 



# Builder - Construye la aplicación

FROM node:22-alpine as build

WORKDIR /usr/src/app

# Copiar de deps, los módulos de node
COPY --from=deps /usr/src/app/node_modules ./node_modules

# Copiar todo el código fuente de la aplicación
COPY . .

RUN npx prisma generate

# Crear la base SQLite (dev.db) aplicando las migraciones
RUN DATABASE_URL=file:./dev.db npx prisma migrate deploy --config prisma7.config.ts && ls -la dev.db

# RUN npm run test
RUN npm run build

RUN npm ci --omit=dev --legacy-peer-deps && npm cache clean --force




# Crear la imagen final de Docker
FROM node:22-alpine as prod 

WORKDIR /usr/src/app

COPY --from=build /usr/src/app/node_modules ./node_modules

# Copiar la carpeta de Dist
COPY --from=build /usr/src/app/dist ./dist
COPY --from=build /usr/src/app/prisma ./prisma
COPY --from=build --chown=node:node /usr/src/app/dev.db ./dev.db

# SQLite necesita escribir en la carpeta (archivo journal)
RUN chown node:node /usr/src/app

ENV NODE_ENV=production

USER node

EXPOSE 3000

CMD [ "node", "dist/main.js" ]